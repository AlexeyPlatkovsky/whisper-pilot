                      "layout": "vertical",
                      "gap": 2,
                      "children": [
                        {
                          "id": "j1tc0c",
                          "type": "ref",
                          "ref": "x2Y3z",
                          "name": "Speaker 1 00:00 - 00:35",
                          "width": "fill_container",
                          "descendants": {
                            "XgrWc": {
                              "fill": "$accent"
                            },
                            "H65Ah": {
                              "content": "Speaker 1"
                            },
                            "R4W9JZ": {
                              "content": "00:00 - 00:35"
                            },
                            "D7n2q": {
                              "content": "Alright, let's kick off the quarterly planning. First, I want to review what shipped last quarter and where we landed against our goals."
                            }
                          }
                        },
                        {
                          "id": "FFAPu",
                          "type": "ref",
                          "ref": "x2Y3z",
                          "name": "Speaker 2 00:35 - 01:02",
                          "width": "fill_container",
                          "descendants": {
                            "XgrWc": {
                              "fill": "$success"
                            },
                            "H65Ah": {
                              "content": "Speaker 2"
                            },
                            "R4W9JZ": {
                              "content": "00:35 - 01:02"
                            },
                            "D7n2q": {
                              "content": "Sounds good. The mobile release went out on time, but we had some regression issues in the billing module that took longer than expected."
                            }
                          }
                        },
                        {
                          "id": "lHfuH",
                          "type": "ref",
                          "ref": "x2Y3z",
                          "name": "Speaker 3 01:02 - 01:28",
                          "width": "fill_container",
                          "descendants": {
                            "XgrWc": {
                              "fill": "$warning"
                            },
                            "H65Ah": {
                              "content": "Speaker 3"
                            },
                            "R4W9JZ": {
                              "content": "01:02 - 01:28"
                            },
                            "D7n2q": {
                              "content": "Do we have a post-mortem on that? I'd like to understand if it was a process gap or just underestimated complexity."
                            }
                          }
                        },
                        {
                          "id": "JLmR6",
                          "type": "ref",
                          "ref": "x2Y3z",
                          "name": "Speaker 1 01:28 - 02:05",
                          "width": "fill_container",
                          "descendants": {
                            "XgrWc": {
                              "fill": "$accent"
                            },
                            "H65Ah": {
                              "content": "Speaker 1"
                            },
                            "R4W9JZ": {
                              "content": "01:28 - 02:05"
                            },
                            "D7n2q": {
                              "content": "It's on the shared drive. The short version: we changed the payment provider integration late in the cycle and didn't have enough regression coverage."
                            }
                          }
                        },
                        {
                          "id": "blUk6",
                          "type": "ref",
                          "ref": "x2Y3z",
                          "name": "Speaker 2 02:05 - 02:40",
                          "width": "fill_container",
                          "descendants": {
                            "XgrWc": {
                              "fill": "$success"
                            },
                            "H65Ah": {
                              "content": "Speaker 2"
                            },
                            "R4W9JZ": {
                              "content": "02:05 - 02:40"
                            },
                            "D7n2q": {
                              "content": "For this quarter, I'd propose we lock provider changes by week four and dedicate sprint six purely to stabilization."
                            }
                          }
                        },
                        {
                          "id": "YawiL",
                          "type": "ref",
                          "ref": "x2Y3z",
                          "name": "Speaker 3 02:40 - 03:12",
