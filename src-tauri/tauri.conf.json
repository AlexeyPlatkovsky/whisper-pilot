{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhisperPilot",
  "version": "1.0.7",
  "identifier": "com.whisperpilot.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "sh scripts/stage-native-dylibs.sh"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1000,
        "height": 760,
        "minWidth": 1000,
        "minHeight": 760,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "frameworks": [
        "frameworks/libsherpa-onnx-c-api.dylib",
        "frameworks/libonnxruntime.1.17.1.dylib",
        "frameworks/libggml-base.0.dylib",
        "frameworks/libggml-cpu.0.dylib",
        "frameworks/libggml-metal.0.dylib",
        "frameworks/libggml.0.dylib",
        "frameworks/libllama-common.0.dylib",
        "frameworks/libllama.0.dylib"
      ],
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
