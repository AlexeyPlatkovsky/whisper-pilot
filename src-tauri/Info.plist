<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Streaming (WP-70): system-audio loopback via ScreenCaptureKit
       (screencapturekit crate). -->
  <key>NSScreenCaptureUsageDescription</key>
  <string>WhisperPilot captures system audio to transcribe a live Streaming session.</string>
  <!-- Recorder (WP-118): requested only after the user starts recording. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>WhisperPilot records microphone audio for local Recorder transcription and playback.</string>
</dict>
</plist>
