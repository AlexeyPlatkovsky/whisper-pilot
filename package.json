{
  "name": "mfupilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "test": "vitest",
    "test:run": "vitest run",
    "test:api": "cargo test --manifest-path src-tauri/Cargo.toml",
