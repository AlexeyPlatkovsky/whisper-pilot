#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
"$root/scripts/bump-version.sh" verify

if git -C "$root" diff --cached --quiet -- package.json package-lock.json src-tauri/Cargo.toml src-tauri/tauri.conf.json; then
  cat >&2 <<'EOF'
FATAL: every commit must stage a version update.
Use `npm run commit:minor -- -m "..."`, `npm run commit:feature -- -m "..."`,
or `npm run commit:release -- -m "..."`.
EOF
  exit 1
fi
